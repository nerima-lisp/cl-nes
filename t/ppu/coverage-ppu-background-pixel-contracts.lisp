(in-package #:cl-nes/test)

(declaim (notinline cl-nes::%ppu-address-bus!))

(describe "Coverage: PPU background pixel contracts"
  (it "uses background enable and left-edge mask bits independently"
    (with-fixture-ppu (ppu (make-fixture-cartridge))
      (setf (ppu-mask ppu) #x08
            (cl-nes::ppu-background-shift-low ppu) #x8000
            (cl-nes::ppu-background-shift-high ppu) 0
            (cl-nes::ppu-fine-x ppu) 0
            (cl-nes::ppu-dot ppu) 1)
      (ppu-write-vram! ppu #x3F00 #x0F)
      (ppu-write-vram! ppu #x3F01 #x2B)
      (multiple-value-bind (color present)
          (cl-nes::%ppu-background-pixel-at-dot ppu)
        (expect color :to-be #x0F)
        (expect present :to-be nil))
      (setf (ppu-mask ppu) #x0A)
      (multiple-value-bind (color present)
          (cl-nes::%ppu-background-pixel-at-dot ppu)
        (expect color :to-be #x2B)
        (expect present :to-be t))
      (setf (cl-nes::ppu-dot ppu) 9
            (ppu-mask ppu) #x02)
      (multiple-value-bind (color present)
          (cl-nes::%ppu-background-pixel-at-dot ppu)
        (expect color :to-be #x0F)
        (expect present :to-be nil))
      (setf (ppu-mask ppu) #x08)
      (multiple-value-bind (color present)
          (cl-nes::%ppu-background-pixel-at-dot ppu)
        (expect color :to-be #x2B)
        (expect present :to-be t))
      (setf (ppu-mask ppu) #x01)
      (ppu-write-vram! ppu #x3F00 #x2B)
      (multiple-value-bind (color present)
          (cl-nes::%ppu-background-pixel-at-dot ppu)
        (expect color :to-be #x2B)
        (expect present :to-be nil))))

  (it "uses background enable and left-edge bits in the direct sampler"
    (with-fixture-ppu (ppu (make-fixture-cartridge))
      (ppu-write-vram! ppu #x0000 #x80)
      (ppu-write-vram! ppu #x2000 0)
      (ppu-write-vram! ppu #x3F00 #x0F)
      (ppu-write-vram! ppu #x3F01 #x21)
      (ppu-write-register! ppu 1 #x08)
      (multiple-value-bind (color present)
          (cl-nes::%background-pixel ppu 0 0)
        (expect color :to-be #x0F)
        (expect present :to-be nil))
      (ppu-write-register! ppu 1 #x0A)
      (multiple-value-bind (color present)
          (cl-nes::%background-pixel ppu 0 0)
        (expect color :to-be #x21)
        (expect present :to-be t))
      (ppu-write-register! ppu 1 #x02)
      (multiple-value-bind (color present)
          (cl-nes::%background-pixel ppu 8 0)
        (expect color :to-be #x0F)
        (expect present :to-be nil))
      (ppu-write-register! ppu 1 #x08)
      (multiple-value-bind (color present)
          (cl-nes::%background-pixel ppu 8 0)
        (expect color :to-be #x21)
        (expect present :to-be t)))))
