(in-package #:cl-nes)

(defconstant +ppu-width+ 256)
(defconstant +ppu-height+ 240)
(defconstant +ppu-vram-size+ #x4000)

(define-hardware-state ppu
  ((cartridge nil nil)
   (a12-clock-enabled-p nil nil)
   (control 0 (unsigned-byte 8))
   (mask 0 (unsigned-byte 8))
  ;; PPUMASK writes reach the rendering pipeline after a short propagation
  ;; delay.  MASK remains the CPU-visible register; these fields hold the
  ;; effective value used by timing-sensitive behavior.
   (rendering-mask 0 (unsigned-byte 8))
   (rendering-mask-pending 0 (unsigned-byte 8))
   (rendering-mask-delay 0 fixnum)
   (rendering-mask-valid-p nil nil)
   ;; Dot 339 observes the rendering gate from the previous dot.
   (rendering-scanline-previous-p nil nil)
   (status 0 (unsigned-byte 8))
   (status-history (make-array 2 :initial-element 0) vector)
   (oam-address 0 (unsigned-byte 8))
   (oam (make-array 256 :element-type '(unsigned-byte 8) :initial-element 0)
        vector)
   (nametable (make-array 2048 :element-type '(unsigned-byte 8) :initial-element 0)
              vector)
   (palette
    (make-array 32 :element-type '(unsigned-byte 8)
                :initial-contents
                '(#x09 #x01 #x00 #x01 #x00 #x02 #x02 #x0D
                  #x08 #x10 #x08 #x24 #x00 #x00 #x04 #x2C
                  #x09 #x01 #x34 #x03 #x00 #x04 #x00 #x14
                  #x08 #x3A #x00 #x02 #x00 #x20 #x2C #x08))
    vector)
   (vram-address 0 fixnum)
   (address-bus 0 fixnum)
   (last-background-read-value 0 (unsigned-byte 8))
   (background-fetch-phase 0 fixnum)
   (background-fetch-address 0 fixnum)
   (background-fetch-v-high 0 fixnum)
   (address-latch-low 0 (unsigned-byte 8))
   (temporary-address 0 fixnum)
   (pending-vram-address-copy-p nil nil)
   (pending-vram-address-copy-delay 0 fixnum)
   (pending-vram-address-copy-value 0 fixnum)
   (pending-vram-address-copy-wait-for-phase1-p nil nil)
   (pending-vram-address-copy-phase1-seen-p nil nil)
   (fine-x 0 fixnum)
   (write-toggle nil nil)
   (scroll-x 0 fixnum)
   (scroll-y 0 fixnum)
   (read-buffer 0 (unsigned-byte 8))
   (read-buffer-pending-p nil nil)
   (read-buffer-pending-delay 0 fixnum)
   (read-buffer-pending-address 0 fixnum)
   (scanline 0 fixnum)
   (dot 0 fixnum)
   (frame-ready-p nil nil)
   (odd-frame-p nil nil)
   (vblank-suppression-p nil nil)
   (nmi-pending-p nil nil)
   (nmi-delay-p nil nil)
   (decay-value 0 (unsigned-byte 8))
   (decay-clock 0 fixnum)
   (decay-deadlines (make-array 8 :initial-element 0) vector)
   (decay-next-expiry most-positive-fixnum fixnum)
   (framebuffer (make-array (* +ppu-width+ +ppu-height+)
                            :element-type '(unsigned-byte 16)
                            :initial-element 0)
                vector)
   (background-shift-low 0 (unsigned-byte 16))
   (background-shift-high 0 (unsigned-byte 16))
   (attribute-shift-low 0 (unsigned-byte 16))
   (attribute-shift-high 0 (unsigned-byte 16))
   (next-tile 0 (unsigned-byte 8))
   (next-attribute 0 (unsigned-byte 8))
   (next-pattern-low 0 (unsigned-byte 8))
   (next-pattern-high 0 (unsigned-byte 8))
   (secondary-oam (make-array 32 :element-type '(unsigned-byte 8) :initial-element #xFF)
                  vector)
   (secondary-oam-count 0 fixnum)
   (oam2-address 0 (unsigned-byte 5))
   (oam2-increment-suppressed-p nil nil)
   (sprite-evaluation-index 0 fixnum)
   (sprite-evaluation-n 0 fixnum)
   (sprite-evaluation-m 0 fixnum)
   (sprite-evaluation-latch #xFF (unsigned-byte 8))
   (sprite-evaluation-done-p nil nil)
   (sprite-evaluation-active-p nil nil)
   (sprite-render-count 0 fixnum)
   (sprite-shift-low (make-array 8 :element-type '(unsigned-byte 8) :initial-element 0)
                     vector)
   (sprite-shift-high (make-array 8 :element-type '(unsigned-byte 8) :initial-element 0)
                      vector)
   (sprite-x-counter (make-array 8 :element-type '(unsigned-byte 8) :initial-element 0)
                     vector)
   (sprite-counter-counting (make-array 8 :initial-element nil)
                            vector)
   (sprite-attributes (make-array 8 :element-type '(unsigned-byte 8) :initial-element 0)
                      vector)
   (sprite-indexes (make-array 8 :element-type '(unsigned-byte 8) :initial-element 0)
                   vector)
   (sprite-evaluated-indexes (make-array 8 :element-type '(unsigned-byte 8) :initial-element 0)
                           vector)
   (sprite-evaluation-phase 0 fixnum)
   (primary-oam-bus-address 0 (unsigned-byte 8))
   (sprite-evaluation-address-latch 0 (unsigned-byte 8))
   (secondary-oam-data-latch #xFF (unsigned-byte 8))
   (sprite-evaluation-overflow-p nil nil)
   (oam-corruption-pending-rows 0 (unsigned-byte 32))
   (sprite-evaluation-secondary-oam-write-p nil nil))
  :constructor %make-ppu
  :exclude (cartridge))

(defconstant +ppu-decay-period+ 1000000)

(defun %ppu-recompute-decay-expiry! (ppu)
  (let ((next-expiry most-positive-fixnum))
    (dotimes (bit 8)
      (let ((deadline (aref (ppu-decay-deadlines ppu) bit)))
        (when (< deadline next-expiry)
          (setf next-expiry deadline))))
    (setf (ppu-decay-next-expiry ppu) next-expiry)))

(defun %ppu-expire-decay! (ppu)
  (let ((now (ppu-decay-clock ppu)))
    (when (<= (ppu-decay-next-expiry ppu) now)
      (dotimes (bit 8)
        (let ((deadline (aref (ppu-decay-deadlines ppu) bit)))
          (when (<= deadline now)
            (setf (ppu-decay-value ppu)
                  (logand (ppu-decay-value ppu)
                          (lognot (ash 1 bit))
                          #xFF)
                  (aref (ppu-decay-deadlines ppu) bit)
                  most-positive-fixnum))))
      (%ppu-recompute-decay-expiry! ppu)))
  ppu)

(defun %ppu-current-decay (ppu)
  (%ppu-expire-decay! ppu)
  (ppu-decay-value ppu))

(defun %ppu-drive-decay! (ppu value &optional (mask #xFF))
  (%ppu-expire-decay! ppu)
  (let ((value (logand value #xFF))
        (mask (logand mask #xFF))
        (deadline (+ (ppu-decay-clock ppu) +ppu-decay-period+)))
    (dotimes (bit 8)
      (let ((bit-mask (ash 1 bit)))
        (when (logbitp bit mask)
          (if (logbitp bit value)
              (setf (ppu-decay-value ppu)
                    (logior (ppu-decay-value ppu) bit-mask))
              (setf (ppu-decay-value ppu)
                    (logand (ppu-decay-value ppu)
                            (lognot bit-mask)
                            #xFF)))
          (setf (aref (ppu-decay-deadlines ppu) bit) deadline))))
    (%ppu-recompute-decay-expiry! ppu))
  value)

(defun %ppu-clock-decay! (ppu ticks)
  (incf (ppu-decay-clock ppu) ticks)
  (%ppu-expire-decay! ppu)
  ppu)
