(in-package #:cl-nes)

(defun %apu-defer-length-halt-write! (apu channel value)
  (let ((bit (ash 1 channel)))
    (setf (apu-length-halt-write-mask apu)
          (logior (apu-length-halt-write-mask apu) bit))
    (if value
        (setf (apu-length-halt-write-values apu)
              (logior (apu-length-halt-write-values apu) bit))
        (setf (apu-length-halt-write-values apu)
              (logandc2 (apu-length-halt-write-values apu) bit))))
  apu)

(defun %apu-write-pulse-control! (apu pulse channel value)
  (setf (apu-pulse-duty pulse) (ldb (byte 2 6) value))
  (let ((envelope (apu-pulse-envelope pulse)))
    (setf (apu-envelope-constant-volume-p envelope) (logbitp 4 value)
          (apu-envelope-volume envelope) (logand value #x0F))
    (%apu-defer-length-halt-write! apu channel (logbitp 5 value))))

(defun %apu-write-pulse-sweep! (pulse value)
  (setf (apu-pulse-sweep-enabled-p pulse) (logbitp 7 value)
        (apu-pulse-sweep-period pulse) (1+ (ldb (byte 3 4) value))
        (apu-pulse-sweep-negate-p pulse) (logbitp 3 value)
        (apu-pulse-sweep-shift pulse) (logand value 7)
        (apu-pulse-sweep-reload-p pulse) t))

(defun %apu-write-triangle-control! (apu triangle value)
  (setf (apu-triangle-linear-reload-value triangle) (logand value #x7F))
  (%apu-defer-length-halt-write! apu 2 (logbitp 7 value)))

(defun %apu-write-noise-control! (apu value)
  (let ((envelope (apu-noise-envelope (apu-noise apu))))
    (setf (apu-envelope-constant-volume-p envelope) (logbitp 4 value)
          (apu-envelope-volume envelope) (logand value #x0F))
    (%apu-defer-length-halt-write! apu 3 (logbitp 5 value))))

(defun %apu-write-length-counter! (apu channel value)
  (let ((length-clock-p (%apu-length-clock-on-next-tick-p apu)))
    (typecase channel
      (apu-pulse
       (when (apu-pulse-enabled-p channel)
         (if (and length-clock-p
                  (plusp (apu-pulse-length-counter channel)))
             (setf (apu-pulse-length-reload-p channel) nil)
             (setf (apu-pulse-length-counter channel) value
                   (apu-pulse-length-reload-p channel) t))))
      (apu-triangle
       (when (apu-triangle-enabled-p channel)
         (if (and length-clock-p
                  (plusp (apu-triangle-length-counter channel)))
             (setf (apu-triangle-length-reload-p channel) nil)
             (setf (apu-triangle-length-counter channel) value
                   (apu-triangle-length-reload-p channel) t))))
      (apu-noise
       (when (apu-noise-enabled-p channel)
         (if (and length-clock-p
                  (plusp (apu-noise-length-counter channel)))
             (setf (apu-noise-length-reload-p channel) nil)
             (setf (apu-noise-length-counter channel) value
                   (apu-noise-length-reload-p channel) t)))))
  value))

(defun apu-write-register! (apu address value)
  (let ((value (logand value #xFF)))
    (case (logand address #xFFFF)
      (#x4000 (%apu-write-pulse-control! apu (apu-pulse-1 apu) 0 value))
      (#x4001 (%apu-write-pulse-sweep! (apu-pulse-1 apu) value))
      (#x4002 (setf (apu-pulse-timer-period (apu-pulse-1 apu))
                    (logior (logand (apu-pulse-timer-period (apu-pulse-1 apu)) #x700)
                            value)))
      (#x4003 (let ((pulse (apu-pulse-1 apu)))
                (%apu-write-length-counter! apu pulse (%apu-length-value value))
                (setf (apu-pulse-timer-period pulse)
                      (logior (ash (logand value 7) 8)
                              (logand (apu-pulse-timer-period pulse) #xFF))
                      (apu-pulse-sequence pulse) 0
                      (apu-envelope-start-p (apu-pulse-envelope pulse)) t)))
      (#x4004 (%apu-write-pulse-control! apu (apu-pulse-2 apu) 1 value))
      (#x4005 (%apu-write-pulse-sweep! (apu-pulse-2 apu) value))
      (#x4006 (setf (apu-pulse-timer-period (apu-pulse-2 apu))
                    (logior (logand (apu-pulse-timer-period (apu-pulse-2 apu)) #x700)
                            value)))
      (#x4007 (let ((pulse (apu-pulse-2 apu)))
                (%apu-write-length-counter! apu pulse (%apu-length-value value))
                (setf (apu-pulse-timer-period pulse)
                      (logior (ash (logand value 7) 8)
                              (logand (apu-pulse-timer-period pulse) #xFF))
                      (apu-pulse-sequence pulse) 0
                      (apu-envelope-start-p (apu-pulse-envelope pulse)) t)))
      (#x4008 (%apu-write-triangle-control! apu (apu-triangle apu) value))
      (#x400A (setf (apu-triangle-timer-period (apu-triangle apu))
                    (logior (logand (apu-triangle-timer-period (apu-triangle apu)) #x700)
                            value)))
      (#x400B (let ((triangle (apu-triangle apu)))
                (%apu-write-length-counter! apu triangle (%apu-length-value value))
                (setf (apu-triangle-timer-period triangle)
                      (logior (ash (logand value 7) 8)
                              (logand (apu-triangle-timer-period triangle) #xFF))
                      (apu-triangle-linear-reload-p triangle) t)))
      (#x400C (%apu-write-noise-control! apu value))
      (#x400E (let ((noise (apu-noise apu)))
                (setf (apu-noise-mode-p noise) (logbitp 7 value)
                      (apu-noise-timer-period noise)
                      (aref +apu-noise-period-table+ (logand value #x0F)))))
      (#x400F (%apu-write-length-counter!
               apu (apu-noise apu) (%apu-length-value value))
             (setf (apu-envelope-start-p
                    (apu-noise-envelope (apu-noise apu))) t))
      (#x4010 (let ((dmc (apu-dmc apu)))
                (setf (apu-dmc-irq-enabled-p dmc) (logbitp 7 value)
                      (apu-dmc-loop-p dmc) (logbitp 6 value)
                      (apu-dmc-rate-index dmc) (logand value #x0F)
                      (apu-dmc-timer-period dmc)
                      (aref +apu-dmc-rate-table+ (logand value #x0F)))
                (unless (apu-dmc-irq-enabled-p dmc)
                  (setf (apu-dmc-irq-pending-p dmc) nil))))
      (#x4011 (setf (apu-dmc-output (apu-dmc apu)) (logand value #x7F)))
      (#x4012 (setf (apu-dmc-sample-address (apu-dmc apu))
                    (+ #xC000 (ash value 6))))
      (#x4013 (setf (apu-dmc-sample-length (apu-dmc apu))
                    (1+ (ash value 4))))
      (#x4015 (%apu-write-status! apu value))
      (#x4017 (%apu-write-frame-counter! apu value)))
    value))
