(in-package #:asdf-user)

(defsystem "cl-nes"
  :description "A headless Nintendo Entertainment System core."
  :author "nerima-lisp"
  :license "MIT"
  :version "0.1.1"
  :homepage "https://github.com/nerima-lisp/cl-nes"
  :source-control (:git "https://github.com/nerima-lisp/cl-nes.git")
  :serial t
  :components
  ((:file "src/package")
   (:file "src/conditions")
   (:file "src/macros")
   (:file "src/apu-data")
   (:file "src/apu-state")
   (:file "src/apu-construction")
   (:file "src/cartridge-layout-data")
   (:file "src/cartridge-state")
   (:file "src/cartridge-construction-data")
   (:file "src/cartridge-construction-validation-helper-macros")
   (:file "src/cartridge-construction-validation-helpers")
   (:file "src/cartridge-construction")
   (:file "src/cartridge-construction-allocation-helpers")
   (:file "src/cartridge-data")
   (:file "src/cartridge-reset")
   (:file "src/cartridge-format-helpers")
   (:file "src/cartridge-format")
   (:file "src/cartridge-mapper22-28-helpers")
   (:file "src/cartridge-mapper1")
   (:file "src/cartridge-mapper22-28")
   (:file "src/cartridge-mapper4")
   (:file "src/cartridge-mapper4-irq")
   (:file "src/cartridge-mapper5-prg-memory")
   (:file "src/cartridge-mapper5-chr-memory")
   (:file "src/cartridge-mapper5-exram")
   (:file "src/cartridge-mapper5-control-data")
   (:file "src/cartridge-mapper5-control")
   (:file "src/cartridge-mapper5-irq")
   (:file "src/cartridge-memory-helper-macros")
   (:file "src/cartridge-memory-helpers")
   (:file "src/cartridge-prg-register-helpers")
   (:file "src/cartridge-prg-access")
   (:file "src/cartridge-memory")
   (:file "src/cartridge-ppu-memory-helpers")
   (:file "src/cartridge-ppu-memory")
   (:file "src/controller-state")
   (:file "src/controller")
   (:file "src/apu-reset-helpers")
   (:file "src/apu")
   (:file "src/apu-lifecycle-data")
   (:file "src/apu-lifecycle-helpers")
   (:file "src/apu-lifecycle")
   (:file "src/apu-envelopes")
   (:file "src/apu-timers")
   (:file "src/apu-dmc-helpers")
   (:file "src/apu-frame")
   (:file "src/apu-timing")
   (:file "src/apu-register-write-helper-macros")
   (:file "src/apu-register-write-helpers")
   (:file "src/apu-register-write-data")
   (:file "src/apu-register-write-macros")
   (:file "src/apu-register-write")
   (:file "src/apu-register-read")
   (:file "src/apu-output")
   (:file "src/ppu-state")
   (:file "src/ppu-reset-helpers")
   (:file "src/ppu")
   (:file "src/ppu-memory")
   (:file "src/ppu-nmi")
   (:file "src/ppu-register-read-data")
   (:file "src/ppu-register-read-macros")
   (:file "src/ppu-register-read")
   (:file "src/ppu-register-write-data")
   (:file "src/ppu-register-write-macros")
   (:file "src/ppu-register-write")
   (:file "src/ppu-rendering")
   (:file "src/ppu-rendering-background")
   (:file "src/ppu-rendering-sprite-helpers")
   (:file "src/ppu-rendering-sprites")
   (:file "src/ppu-decay")
   (:file "src/ppu-timing")
   (:file "src/bus-state")
   (:file "src/bus")
   (:file "src/bus-dma")
   (:file "src/cpu-state")
   (:file "src/cpu-macros")
   (:file "src/cpu")
   (:file "src/cpu-addressing-macros")
   (:file "src/cpu-addressing")
   (:file "src/cpu-stack")
   (:file "src/cpu-alu-macros")
   (:file "src/cpu-alu")
   (:file "src/cpu-control-data")
   (:file "src/cpu-control-helper-macros")
   (:file "src/cpu-control-helpers")
   (:file "src/cpu-control")
   (:file "src/cpu-opcode-helpers")
   (:file "src/cpu-opcodes-00-7f-data")
   (:file "src/cpu-opcodes-00-7f")
   (:file "src/cpu-opcodes-80-ff-data")
   (:file "src/cpu-opcodes-80-ff")
   (:file "src/cpu-instructions")
   (:file "src/nes-state")
   (:file "src/nes")
   (:file "src/nes-timing")
   (:file "src/nes-execution-helpers")
   (:file "src/nes-execution"))
  :in-order-to ((test-op (test-op "cl-nes/test"))))

(defsystem "cl-nes/test"
  :description "cl-nes tests driven by cl-weave."
  :depends-on ("cl-nes" "cl-weave")
  :pathname "t"
  :serial t
  :components
  ((:file "package")
     (:file "fixture-cartridge-support")
     (:file "fixture-expectation-support")
     (:file "fixture-write-macros")
     (:file "fixture-device-macros")
     (:file "fixture-cpu-macros")
     (:file "properties")
     (:file "bus-contracts")
     (:file "loader-edge-cases")
     (:file "condition-reports")
     (:file "controller-boundaries")
     (:file "apu-boundaries")
     (:file "cartridge-constructor-validation-contracts")
     (:file "cartridge-constructor-initialization-contracts")
     (:file "cartridge-reset-contracts")
     (:file "cartridge-mapper-write-contracts")
     (:file "cartridge-memory-contracts")
     (:file "apu-register-contracts")
     (:file "apu-timing-contracts")
     (:file "apu-frame-contracts")
     (:file "cpu-opcodes-00-7f")
     (:file "cpu-opcodes-80-ff")
     (:file "cpu-state-transitions")
     (:file "cpu-interrupt-transitions")
     (:file "cpu-alu-flag-transitions")
     (:file "cpu-addressing-transitions")
     (:file "nes-transitions")
     (:file "ppu-transition-support")
     (:file "ppu-register-transitions")
     (:file "ppu-memory-mapping")
     (:file "ppu-pixel-selection")
     (:file "ppu-frame-timing")
     (:file "bus-transitions")
     (:file "public-api-core")
     (:file "public-api-mapper4")
     (:file "public-api-mapper5-prg-banking")
     (:file "public-api-mapper5-chr-routing")
     (:file "public-api-mapper5-exram-irq")
     (:file "public-api-mapper5-non-mmc5")
     (:file "coverage-cartridge-apu")
     (:file "coverage-mappers")
     (:file "coverage-cartridge-memory-mmc1")
     (:file "coverage-cartridge-memory-discrete-windows")
     (:file "coverage-cartridge-memory-vrc2-action53")
     (:file "coverage-cartridge-memory-prg-ram-bus")
     (:file "coverage-cartridge-memory-cpu-mmc5")
     (:file "coverage-cpu-irq-delay")
     (:file "coverage-ppu-register-side-effects")
     (:file "coverage-ppu-rendering-phases")
     (:file "coverage-ppu-frame-wrap")
     (:file "coverage-loaders")
     (:file "coverage-nes-timing")
     (:file "coverage-runtime-ppu")
     (:file "coverage-runtime-nes"))
  :perform
  (test-op (operation component)
    (declare (ignore operation))
    (unless (uiop:symbol-call :cl-weave :run-all
                              :reporter :spec
                              :pass-with-no-tests nil)
      (error "cl-nes cl-weave test suite failed."))))
